{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "background": true,
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultDuotone": false,
      "defaultGradients": true,
      "defaultPalette": false,
      "link": true,
      "text": true,
      "palette": [
        {
          "color": "#297bbf",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#1e6aa5",
          "name": "Primary Dark",
          "slug": "primary-dark"
        },
        {
          "color": "#dbeafe",
          "name": "Primary Light",
          "slug": "primary-light"
        },
        {
          "color": "#ffffff",
          "name": "Background",
          "slug": "background"
        },
        {
          "color": "#1c1c22",
          "name": "Foreground",
          "slug": "foreground"
        },
        {
          "color": "#f5f5f7",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "color": "#3f3f47",
          "name": "Secondary Foreground",
          "slug": "secondary-foreground"
        },
        {
          "color": "#f5f5f7",
          "name": "Muted",
          "slug": "muted"
        },
        {
          "color": "#717179",
          "name": "Muted Foreground",
          "slug": "muted-foreground"
        },
        {
          "color": "#e53935",
          "name": "Destructive",
          "slug": "destructive"
        },
        {
          "color": "#e5e5ea",
          "name": "Border",
          "slug": "border"
        },
        {
          "color": "#000000",
          "name": "Black",
          "slug": "black"
        },
        {
          "color": "#ffffff",
          "name": "White",
          "slug": "white"
        }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(135deg, #297bbf 0%, #1e6aa5 100%)",
          "name": "Primary Gradient",
          "slug": "primary-gradient"
        },
        {
          "gradient": "linear-gradient(135deg, #297bbf 0%, #3b82f6 100%)",
          "name": "Blue Gradient",
          "slug": "blue-gradient"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Inter', system-ui, -apple-system, sans-serif",
          "name": "Inter",
          "slug": "inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "src": [
                "https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiA.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "'Montserrat', 'Inter', sans-serif",
          "name": "Montserrat",
          "slug": "montserrat",
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "src": [
                "https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCtr6Hw5aXo.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "'Geist', system-ui, sans-serif",
          "name": "Geist",
          "slug": "geist"
        },
        {
          "fontFamily": "'Red Hat Display', 'Montserrat', sans-serif",
          "name": "Red Hat Display",
          "slug": "red-hat-display"
        }
      ],
      "fontSizes": [
        {
          "name": "X-Small",
          "size": "0.75rem",
          "slug": "x-small"
        },
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.125rem",
          "slug": "large"
        },
        {
          "name": "X-Large",
          "size": "1.25rem",
          "slug": "x-large"
        },
        {
          "name": "2X-Large",
          "size": "1.5rem",
          "slug": "2x-large"
        },
        {
          "name": "3X-Large",
          "size": "1.875rem",
          "slug": "3x-large"
        },
        {
          "name": "4X-Large",
          "size": "2.25rem",
          "slug": "4x-large"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "steps": 8,
        "mediumStep": 1.5,
        "unit": "rem",
        "operator": "*",
        "increment": 1.5,
        "values": []
      },
      "spacingSizes": [
        { "name": "1", "size": "0.25rem",  "slug": "10" },
        { "name": "2", "size": "0.5rem",   "slug": "20" },
        { "name": "3", "size": "0.75rem",  "slug": "30" },
        { "name": "4", "size": "1rem",     "slug": "40" },
        { "name": "5", "size": "1.25rem",  "slug": "50" },
        { "name": "6", "size": "1.5rem",   "slug": "60" },
        { "name": "8", "size": "2rem",     "slug": "80" },
        { "name": "10", "size": "2.5rem",  "slug": "100" },
        { "name": "12", "size": "3rem",    "slug": "120" },
        { "name": "16", "size": "4rem",    "slug": "160" },
        { "name": "20", "size": "5rem",    "slug": "200" }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "minHeight": true
    },
    "layout": {
      "contentSize": "768px",
      "wideSize": "1280px"
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": true,
          "text": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "700"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "600"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "600"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "600"
        },
        "border": {
          "radius": "0.65rem"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "700"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--montserrat)",
          "fontWeight": "700"
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ],
  "customTemplates": [
    {
      "name": "full-width",
      "postTypes": ["page", "post"],
      "title": "Full Width"
    },
    {
      "name": "page-with-sidebar",
      "postTypes": ["page"],
      "title": "Page with Sidebar"
    }
  ]
}
